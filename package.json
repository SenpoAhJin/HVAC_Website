{
  "name": "premier-tech-solution",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:vercel",
    "prebuild": "node scripts/check-placeholders.js",
    "build:deploy": "npm run build:greengeeks",
    "build:greengeeks": "cross-env VITE_CONTACT_ENDPOINT=/api/contact.php vite build && node scripts/postbuild-replace-urls.js && node scripts/build-deploy.js",
    "build:vercel": "cross-env VITE_DEPLOY_TARGET=vercel VITE_CONTACT_ENDPOINT=/api/contact vite build && node scripts/inject-noindex.js",
    "build:github": "cross-env VITE_BASE=/HVAC_Website/ VITE_DEPLOY_TARGET=github VITE_CONTACT_ENDPOINT=/api/contact vite build && node scripts/postbuild-github.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:placeholders": "node scripts/check-placeholders.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "glob": "^11.1.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "react-router-dom": "^7.18.4",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
