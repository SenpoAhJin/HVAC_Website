# Environment Variables Configuration
# Copy this file to .env.local for local development
# Add these to your deployment platform (Vercel, Netlify, etc.)

# OpenAI API Key for chatbot (required for chatbot to work)
OPENAI_API_KEY=your_openai_api_key_here

# Email service API key (required for contact form to send emails)
# Options: SendGrid, Resend, Postmark, AWS SES, etc.
EMAIL_API_KEY=your_email_api_key_here

# Email address to receive contact form submissions
TO_EMAIL=info@premiertechsolution.com

# Chatbot Knowledge Base (or load from knowledge-base.txt)
# CHATBOT_KNOWLEDGE="Your custom knowledge base text here..."
