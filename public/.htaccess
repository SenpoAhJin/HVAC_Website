# Apache configuration for Premier Tech Solution
# Enables SPA routing, HTTPS enforcement, and security

# Disable directory listing
Options -Indexes

# Force HTTPS for premiertechsolution.us only
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Force HTTPS (redirect http to https for this site only)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(www\.)?premiertechsolution\.us$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    
    # Block direct web access to keepalive.php (CLI/cron only)
    RewriteCond %{REQUEST_URI} ^/api/keepalive\.php$ [NC]
    RewriteRule ^ - [F,L]
    
    # SPA fallback routing
    RewriteBase /
    
    # Don't rewrite files or directories that exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Don't rewrite API calls
    RewriteCond %{REQUEST_URI} !^/api/
    
    # Rewrite everything else to index.html (SPA fallback)
    RewriteRule ^ index.html [L]
</IfModule>

# Cache static assets for 1 year
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Assets folder (hashed filenames)
    <FilesMatch "\.(js|css|woff|woff2|ttf|eot|svg|jpg|jpeg|png|gif|webp|ico)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, immutable"
    </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Security headers
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
